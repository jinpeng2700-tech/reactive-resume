# Copy to /etc/reactive-resume/reactive-resume.env on Tencent. Do not commit real values.
IMAGE=ghcr.io/jinpeng2700-tech/reactive-resume-tencent:sha-REPLACE_WITH_12_HEX_SHA
APP_URL=https://resume.ai2c.cloud
POSTGRES_DB=reactive_resume
POSTGRES_USER=reactive_resume
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DATABASE_URL=postgresql://reactive_resume:REPLACE_WITH_RANDOM_VALUE@postgres:5432/reactive_resume
AUTH_SECRET=REPLACE_WITH_64_HEX_CHARS
ENCRYPTION_SECRET=REPLACE_WITH_64_HEX_CHARS
S3_ACCESS_KEY_ID=reactive_resume
S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_VALUE
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=reactive-resume
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://redis:6379
FLAG_DISABLE_SIGNUPS=false
FLAG_DISABLE_EMAIL_AUTH=false
